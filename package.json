{
  "name": "kshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @kshare/database db:generate || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:https": "pnpm --filter web dev:https",
    "desktop:dev": "pnpm --filter kshare-desktop dev",
    "desktop:dist": "pnpm --filter kshare-desktop dist",
    "desktop:dist:linux": "pnpm --filter kshare-desktop dist:linux",
    "desktop:dist:win": "pnpm --filter kshare-desktop dist:win",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @kshare/database db:generate",
    "db:push": "pnpm --filter @kshare/database db:push"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.18.0"
}
