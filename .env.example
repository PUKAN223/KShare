# KShare Environment Variables

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Managed Database URL (PostgreSQL)
# e.g., DATABASE_URL="postgresql://user:password@localhost:5432/kshare?schema=public"
DATABASE_URL="postgresql://localhost:5432/kshare"

# VDO.Ninja Configuration (Defaults to official hosted servers)
NEXT_PUBLIC_VDO_NINJA_SERVER="https://vdo.ninja"

# Optional Custom STUN / TURN credentials if not using default OpenRelay
# TURN_URL="turn:your-turn-server.com:3478"
# TURN_USERNAME="your-username"
# TURN_CREDENTIAL="your-password"
